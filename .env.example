VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Used by the frontend API route to call the deployed Python recommender service.
RECOMMENDER_SERVICE_URL=https://your-recommender-service.example.com
RECOMMENDER_SERVICE_SECRET=shared-secret-between-api-and-recommender-service

# Used by recommend_batch.py and recommend_fast.py for the saved CF artifact.
SUPABASE_RECOMMENDER_BUCKET=recommender-artifacts
SUPABASE_RECOMMENDER_ARTIFACT=cf_item_factors.npz
RECOMMENDER_ARTIFACT_CACHE_TTL_SECONDS=600
