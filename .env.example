VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Server-only key used by /api/generate and /api/ibs-check-in.
GEMINI_TAMAR_API_KEY=your-gemini-api-key

# Used by the frontend API route to call the deployed Python recommender service.
RECOMMENDER_SERVICE_URL=https://your-recommender-service.example.com
RECOMMENDER_SERVICE_SECRET=shared-secret-between-api-and-recommender-service

# Optional: used by /api/fill-recipe-images to cache exact recipe photos in recipe_images.
PEXELS_API_KEY=your-pexels-api-key

# Used by recommend_batch.py and recommend_fast.py for the saved hybrid
# preference artifact and the trained symptom-risk artifact.
SUPABASE_RECOMMENDER_BUCKET=recommender-artifacts
SUPABASE_RECOMMENDER_ARTIFACT=cf_item_factors.npz
SUPABASE_SYMPTOM_MODEL_ARTIFACT=xgboost_symptom_model.pkl
RECOMMENDER_ARTIFACT_CACHE_TTL_SECONDS=600
RECOMMENDER_SYMPTOM_ARTIFACT_CACHE_TTL_SECONDS=600

# Optional model tuning. Food.com ratings below this threshold are not treated
# as positive WARP examples; fresh online evidence reaches full blend strength
# once its cumulative interaction weight reaches the configured value.
RECOMMENDER_HISTORICAL_POSITIVE_MIN_RATING=4
RECOMMENDER_ONLINE_VECTOR_WEIGHT=0.35
RECOMMENDER_ONLINE_VECTOR_FULL_STRENGTH=5
RECOMMENDER_ONLINE_SCORE_DELTA_LIMIT=1
# Optional batch model base label; a unique training generation is appended.
# RECOMMENDER_PREFERENCE_MODEL_NAME=tamar_preference
RECOMMENDER_SYMPTOM_MIN_TRAINING_ROWS=100
RECOMMENDER_SYMPTOM_MIN_CLASS_ROWS=20
RECOMMENDER_SYMPTOM_MIN_USERS=5
